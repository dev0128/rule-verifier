                        "Effect": "Deny",
                        "Principal": {
                          "AWS": "arn:aws:iam::999999999999:root"
                        },
                        "Action": [
                          "ses:SendEmail",
                          "ses:SendRawEmail"
                        ],
                        "Resource": "arn:aws:ses:ap-northeast-2:111122223333:identity/example.com"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1,
        "flag": 0
      },
      "why": "Deny 는 액세스를 막는 문 — 교차 계정 허용이 아니다"
    },
    {
