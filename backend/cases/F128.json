                  "ManagedByFirewallManager": false
                }
              }
            ],
            "list_rule_groups": [],
            "list_ip_sets": []
          },
          "account": {
            "get_owner_id": [
              {
                "OwnerId": "111122223333"
              }
            ]
          }
