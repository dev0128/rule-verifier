      "expect": {
        "verdict": "Secure",
        "good": 1
      }
    },
    {
      "id": "no-acl-anywhere",
      "role": "control",
      "condition": "어느 리전에도 Web ACL 없음 (list_web_acls=[])",
      "args": [],
