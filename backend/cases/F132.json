{
  "finding": "F132",
  "rule": "REME-0100800008",
  "service": "elb",
  "status": "reproducible",
  "note": "elb.py:472-502 — 리스너 루프에서 flag 를 누적 없이 덮어쓴다. HTTPS/TLS 가 아닌 리스너를 만나면 flag='n/a' 로 바뀌어, 마지막 리스너가 HTTP 면 취약·양호가 모두 n/a 가 된다. 리스너가 없는 LB 는 초기값 False 그대로 양호.",
  "scenarios": [
    {
      "id": "weak-https-then-http",
      "role": "bug",
      "condition": "ALB 리스너 [HTTPS:443 SslPolicy=ELBSecurityPolicy-2016-08, HTTP:80 → HTTPS redirect] (HTTP 가 뒤)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "elbv2": {
            "describe_load_balancers": [
              {
                "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:loadbalancer/app/alb-weak/50dc6c495c0c9188",
                "DNSName": "alb-weak-123.ap-northeast-2.elb.amazonaws.com",
                "LoadBalancerName": "alb-weak",
                "Scheme": "internet-facing",
                "VpcId": "vpc-1",
                "State": {
                  "Code": "active"
                },
                "Type": "application",
                "IpAddressType": "ipv4",
                "Attributes": [],
                "Listeners": [
                  {
                    "Port": 443,
                    "Protocol": "HTTPS",
                    "SslPolicy": "ELBSecurityPolicy-2016-08",
                    "Certificates": [
                      {
                        "CertificateArn": "arn:aws:acm:ap-northeast-2:111111111111:certificate/abc"
                      }
                    ],
                    "DefaultActions": [
                      {
                        "Type": "forward",
                        "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:targetgroup/tg/0123456789abcdef",
                        "Order": 1
                      }
                    ],
                    "ListenerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:listener/app/alb-weak/50dc6c495c0c9188/0000000000000000",
                    "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:loadbalancer/app/alb-weak/50dc6c495c0c9188"
                  },
                  {
                    "Port": 80,
                    "Protocol": "HTTP",
                    "DefaultActions": [
                      {
                        "Type": "redirect",
                        "Order": 1,
                        "RedirectConfig": {
                          "Protocol": "HTTPS",
                          "Port": "443",
                          "Host": "#{host}",
                          "Path": "/#{path}",
                          "Query": "#{query}",
                          "StatusCode": "HTTP_301"
                        }
                      }
                    ],
                    "ListenerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:listener/app/alb-weak/50dc6c495c0c9188/0000000000000001",
                    "LoadBalancerArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:loadbalancer/app/alb-weak/50dc6c495c0c9188"
                  }
                ],
                "Tags": {}
              }
            ],
            "describe_target_groups": []
          }
        },
        "globals": {
          "wafv2": {
            "list_web_acls": []
          },
          "waf": {
            "list_web_acls": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "ELBSecurityPolicy-2016-08 은 TLS1.0/1.1 을 허용하는 안전하지 않은 정책 — 같은 LB 에 HTTP 리스너가 있다고 해서 점검 대상에서 빠지면 안 된다"
    },
