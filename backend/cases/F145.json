{
  "finding": "F145",
  "rule": "REME-0106000001",
  "service": "ecr",
  "status": "reproducible",
  "effect": "wrong_logic",
  "note": "ecr.py:33-36 — Principal 이 문자열 '*' 일 때만 퍼블릭으로 본다. {'AWS':'*'}·{'AWS':['*']} 는 놓치고(미탐), Effect 를 보지 않아 Deny '*' 를 퍼블릭으로 본다(오탐). Statement 가 단일 객체면 dict 키를 순회해 AttributeError. 미탐·오탐·예외가 섞여 effect 를 wrong_logic 으로 바로잡음.",
  "scenarios": [
    {
      "id": "aws-star",
      "role": "bug",
      "condition": "리포지토리 정책 Allow + Principal {'AWS': '*'} (콘솔에서 '모든 사용자' 지정한 형태)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "ecr": {
            "describe_registry": [
              {
                "registryId": "111111111111",
                "replicationConfiguration": {
                  "rules": []
                }
              }
            ],
            "describe_repositories": [
              {
                "repositoryArn": "arn:aws:ecr:ap-northeast-2:111111111111:repository/pub1",
                "registryId": "111111111111",
                "repositoryName": "pub1",
                "repositoryUri": "111111111111.dkr.ecr.ap-northeast-2.amazonaws.com/pub1",
                "createdAt": "2024-01-01T00:00:00+09:00",
                "imageTagMutability": "MUTABLE",
                "imageScanningConfiguration": {
                  "scanOnPush": false
                },
                "encryptionConfiguration": {
                  "encryptionType": "AES256"
                },
                "policyText": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": "s1",
                      "Effect": "Allow",
                      "Principal": {
                        "AWS": "*"
                      },
                      "Action": [
                        "ecr:BatchGetImage",
                        "ecr:GetDownloadUrlForLayer"
                      ]
                    }
                  ]
                },
                "lifecyclePolicyText": {}
              }
            ],
            "describe_images": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "{'AWS':'*'} 는 모든 AWS 보안 주체(익명 포함) — 퍼블릭 액세스 허용"
