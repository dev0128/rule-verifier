{
  "finding": "F131",
  "rule": "REME-0106100003",
  "service": "vpc",
  "status": "reproducible",
  "note": "Analyze/vpc.py:153, 260, 369-370, 485, 532-533 — raw[region]['ec2'] / ['networkfirewall'] 를 가드 없이 접근. 한 리전이라도 수집이 비면 룰 전체 KeyError. 같은 파일 VPC-001/002/010 은 `if not ...get('ec2'): continue` 가드가 있다.",
  "scenarios": [
    {
      "id": "vpc003-missing-region",
      "role": "bug",
      "rule": "REME-0106100003",
      "condition": "VPC-003: ap-northeast-2 · us-east-1 에 비기본 VPC, me-south-1 은 수집이 비어 {}",
      "args": [],
      "raw": {
        "globals": {
          "account": {
            "get_owner_id": [
              {
                "OwnerId": "111111111111"
              }
            ]
          }
        },
        "ap-northeast-2": {
          "ec2": {
            "describe_vpcs": [
              {
                "VpcId": "vpc-1",
                "IsDefault": false
              }
            ]
          }
        },
        "us-east-1": {
          "ec2": {
            "describe_vpcs": [
              {
                "VpcId": "vpc-2",
                "IsDefault": false
              }
            ]
          }
        },
        "me-south-1": {}
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      },
      "why": "수집이 빈 리전은 건너뛰고 나머지로 판정해야 한다 — 두 리전에 비기본 VPC 가 있으므로 다중 리전 양호"
    },
    {
