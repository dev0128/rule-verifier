{
  "finding": "F064",
  "rule": "REME-0101200002",
  "service": "apigateway",
  "status": "reproducible",
  "note": "Analyze/apigateway.py:184 — v2 스테이지를 DefaultRouteSettings.get('loggingLevel') 로 읽는다. apigatewayv2 GetStages 필드명은 LoggingLevel(대문자 L)이라 항상 'OFF' 로 간주. HTTP API 는 실행 로깅(LoggingLevel)이 없고 AccessLogSettings 로만 로깅하는데 이를 보지 않는다 → v2 API 전부 취약.",
  "scenarios": [
    {
      "id": "ws-logging-info",
      "role": "bug",
      "condition": "WebSocket API 스테이지 DefaultRouteSettings.LoggingLevel=INFO",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "apigateway": {
            "get_client_certificates": [],
            "v1_apis": [],
            "v2_apis": [
              {
                "ApiId": "v2ws1",
                "Name": "ws1",
                "ProtocolType": "WEBSOCKET",
                "ApiEndpoint": "wss://v2ws1.execute-api.ap-northeast-2.amazonaws.com",
                "ApiKeySelectionExpression": "$request.header.x-api-key",
                "CreatedDate": "2026-01-01T00:00:00+09:00",
                "DisableExecuteApiEndpoint": false,
                "RouteSelectionExpression": "$request.body.action",
                "Tags": {},
                "integrations": [],
                "stages": [
                  {
                    "StageName": "$default",
                    "AutoDeploy": false,
                    "DefaultRouteSettings": {
                      "DetailedMetricsEnabled": false,
                      "DataTraceEnabled": false,
                      "ThrottlingBurstLimit": 5000,
                      "ThrottlingRateLimit": 10000.0,
                      "LoggingLevel": "INFO"
                    },
                    "RouteSettings": {},
                    "StageVariables": {},
                    "Tags": {},
                    "CreatedDate": "2026-01-01T00:00:00+09:00",
                    "LastUpdatedDate": "2026-01-01T00:00:00+09:00"
                  }
                ]
              }
            ]
          }
        },
        "globals": {
          "cloudfront": {
            "list_distributions": []
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1,
        "flag": 0
      },
      "why": "WebSocket API 실행 로깅이 INFO 로 켜져 있으므로 로깅 활성"
    },
