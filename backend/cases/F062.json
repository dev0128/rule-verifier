    {
      "id": "alarm-other-namespace",
      "role": "bug",
      "condition": "CWH-001 CIS 필터(namespace CISBenchmark) + MetricName 만 같고 Namespace=OtherApp 인 경보 + 다중 리전 trail",
      "args": [],
      "raw": {
        "globals": {
          "account": {
            "get_owner_id": [
              {
                "OwnerId": "111122223333"
              }
