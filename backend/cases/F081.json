{
  "finding": "F081",
  "rule": "REME-0102200009",
  "service": "redshift",
  "status": "reproducible",
  "note": "redshift.py:461 `if not key_data[key_value[0]] ...` — key_value[0] 은 'Snapshots'(수집기가 붙인 describe_cluster_snapshots 결과, 수동+자동), 봐야 할 것은 key_value[1] 'AutomatedSnapshotRetentionPeriod'(0 이면 자동 스냅샷 꺼짐).",
  "scenarios": [
    {
      "id": "retention0-manual-snapshot",
      "role": "bug",
      "condition": "AutomatedSnapshotRetentionPeriod=0, 수동 스냅샷 1개 있음",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "redshift": {
            "describe_clusters": [
              {
                "ClusterIdentifier": "rs-1",
                "NodeType": "ra3.xlplus",
                "ClusterStatus": "available",
                "ClusterAvailabilityStatus": "Available",
                "AutomatedSnapshotRetentionPeriod": 0,
                "ManualSnapshotRetentionPeriod": -1,
                "AllowVersionUpgrade": true,
                "Encrypted": true,
                "ClusterParameterGroups": [
                  {
                    "ParameterGroupName": "default.redshift-1.0",
                    "ParameterApplyStatus": "in-sync"
                  }
                ],
                "Tags": {},
                "Endpoint": {
                  "Address": "rs-1.abc123.ap-northeast-2.redshift.amazonaws.com",
                  "Port": 5439
                },
                "logging_status": {
                  "LoggingEnabled": false
                },
                "Snapshots": [
                  {
                    "SnapshotIdentifier": "rs-1-2026-11-01",
                    "ClusterIdentifier": "rs-1",
                    "SnapshotType": "manual",
                    "Status": "available",
                    "SnapshotCreateTime": "2026-11-01T00:00:00Z"
                  }
                ]
              }
