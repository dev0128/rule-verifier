                  {
                    "ParameterName": "require_ssl",
                    "ParameterValue": "false",
                    "Source": "engine-default",
                    "DataType": "boolean",
                    "ApplyType": "static",
                    "IsModifiable": true
                  }
                ]
              }
            ],
            "describe_cluster_security_groups": [],
            "describe_cluster_parameters": []
