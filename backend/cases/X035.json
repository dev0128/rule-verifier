{
  "finding": "X035",
  "rule": "REME-0105300001",
  "service": "dlm",
  "status": "reproducible",
  "note": "dlm.py — ① ExcludeVolumeTypes(:59-67)·ExcludeBootVolumes(:70-78) 는 '이미 제외 목록에 있을 때만' 추가하는 반전 조건이라 새로 제외되는 볼륨이 없다 ② 정책별 excepted_volume 에 '그 정책 대상이 아닌 볼륨'을 넣고(:97) 마지막에 합쳐서, 정책이 2개면 서로의 대상을 취약으로 만든다 ③ TargetTags 키마다 같은 처리를 반복해 결국 마지막 키에 맞지 않으면 취약(태그 OR 조건 무시) ④ 정책이 있으나 ENABLED EBS 스냅샷 정책이 하나도 없으면 AllFlag=False·제외 목록 비어 전부 양호.",
  "scenarios": [
    {
      "id": "exclude-volume-types",
      "role": "bug",
      "condition": "기본 정책 Exclusions.ExcludeVolumeTypes=[sc1] + 볼륨 2개: vol-gp3(gp3) · vol-sc1(sc1), 둘 다 태그 있음",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "dlm": {
            "get_lifecycle_policy": [
              {
                "PolicyId": "policy-default",
                "Description": "default policy",
                "State": "ENABLED",
                "StatusMessage": "ENABLED",
                "ExecutionRoleArn": "arn:aws:iam::111111111111:role/AWSDataLifecycleManagerDefaultRole",
                "DateCreated": "2024-01-01T00:00:00+09:00",
                "DateModified": "2024-01-01T00:00:00+09:00",
                "PolicyDetails": {
                  "PolicyLanguage": "SIMPLIFIED",
                  "PolicyType": "EBS_SNAPSHOT_MANAGEMENT",
                  "ResourceType": "VOLUME",
                  "CreateInterval": 1,
                  "RetainInterval": 7,
                  "Exclusions": {
                    "ExcludeBootVolumes": false,
                    "ExcludeVolumeTypes": [
                      "sc1"
                    ],
                    "ExcludeTags": {}
                  }
                },
                "Tags": {},
                "PolicyArn": "arn:aws:dlm:ap-northeast-2:111111111111:policy/policy-default",
                "DefaultPolicy": true
              }
            ]
          },
          "ec2": {
            "describe_volumes": [
              {
                "VolumeId": "vol-gp3",
                "Size": 20,
                "AvailabilityZone": "ap-northeast-2a",
                "State": "available",
                "CreateTime": "2024-01-01T00:00:00+09:00",
                "Encrypted": true,
                "VolumeType": "gp3",
                "MultiAttachEnabled": false,
                "Attachments": [],
                "Tags": {
                  "env": "prd"
                }
              },
              {
                "VolumeId": "vol-sc1",
                "Size": 20,
                "AvailabilityZone": "ap-northeast-2a",
                "State": "available",
                "CreateTime": "2024-01-01T00:00:00+09:00",
                "Encrypted": true,
                "VolumeType": "sc1",
                "MultiAttachEnabled": false,
                "Attachments": [],
                "Tags": {
                  "env": "prd"
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 2,
        "flag": 1,
        "good": 1,
        "flag_contains": [
          "vol-sc1"
        ]
      },
      "why": "sc1 볼륨은 기본 정책에서 제외되어 스냅샷이 만들어지지 않는다 → 취약"
    },
