{
  "finding": "F015",
  "rule": "REME-0100100006",
  "service": "iam",
  "status": "reproducible",
  "note": "iam.py:462-471 — date1(마지막 사용일)·date2(발급/변경일) 중 하나라도 N/A·no_information 이면 활성 여부·발급일과 상관없이 \"n/a\". 교체 판정(boolean_3)은 date2 만 쓰는데도 미사용(date1=N/A) 키·비밀번호를 건너뛴다.",
  "scenarios": [
    {
      "id": "active-key-never-used-old",
      "role": "bug",
      "condition": "활성 액세스 키 1, 2020-01-01 발급 후 한 번도 사용 안 함 (last_used_date=N/A), 비밀번호 없음",
      "args": [
        "90"
      ],
      "raw": {
        "globals": {
          "iam": {
            "get_credential_report": [
              {
                "user": "unused-key",
                "arn": "arn:aws:iam::111111111111:user/unused-key",
                "user_creation_time": "2020-01-01T00:00:00+00:00",
                "password_enabled": "false",
