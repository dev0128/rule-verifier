        "flag": 1
      }
    },
    {
      "id": "aws-star",
      "role": "control",
      "condition": "정책 Principal = {\"AWS\": \"*\"}",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "opensearch": {
            "describe_domains": [
              {
                "DomainId": "111122223333/d-star",
                "DomainName": "d-star",
                "ARN": "arn:aws:es:ap-northeast-2:111122223333:domain/d-star",
                "Created": true,
                "Deleted": false,
                "Processing": false,
                "EngineVersion": "OpenSearch_2.11",
                "Endpoint": "search-d-star-abc.ap-northeast-2.es.amazonaws.com",
                "AccessPolicies": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "AWS": "*"
                      },
                      "Action": "es:*",
                      "Resource": "arn:aws:es:ap-northeast-2:111122223333:domain/d-star/*"
                    }
                  ]
                },
                "Tags": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    }
  ]
}
