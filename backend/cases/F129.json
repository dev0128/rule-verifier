      "role": "control",
      "condition": "정책 Principal = 타 계정 999988887777 root",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "opensearch": {
            "describe_domains": [
              {
                "DomainId": "111122223333/d-cross",
