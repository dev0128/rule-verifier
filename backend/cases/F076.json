{
  "finding": "F076",
  "rule": "REME-0100700017",
  "service": "s3",
  "status": "reproducible",
  "note": "s3.py:1022 — get_bucket_acl 응답의 그룹 URI 는 Grants[].Grantee.URI 에 있는데 grant 최상위 URI 만 본다(항상 ''). S3-011(s3.py:654-657)은 Grantee.URI 로 폴백한다.",
  "scenarios": [
    {
      "id": "allusers-write",
      "role": "bug",
      "condition": "버킷 ACL 에 AllUsers 그룹 WRITE 부여, 버킷 퍼블릭 액세스 차단 4종 모두 false",
      "args": [],
      "raw": {
        "globals": {
          "s3": {
            "list_buckets": [
              {
                "Name": "pub-write",
                "CreationDate": "2024-01-01T00:00:00+00:00",
                "LocationConstraint": "ap-northeast-2",
                "bucket_versioning": {
                  "Status": "Enabled",
                  "MFADelete": null
                },
                "Grants": [
                  {
                    "Grantee": {
                      "Type": "CanonicalUser",
                      "ID": "abc123owner",
                      "DisplayName": "owner"
                    },
                    "Permission": "FULL_CONTROL"
                  },
                  {
                    "Grantee": {
                      "Type": "Group",
                      "URI": "http://acs.amazonaws.com/groups/global/AllUsers"
                    },
                    "Permission": "WRITE"
                  }
                ],
                "Policy": {},
                "PolicyStatus": {},
                "PublicAccessBlockConfiguration": {
                  "BlockPublicAcls": false,
                  "IgnorePublicAcls": false,
                  "BlockPublicPolicy": false,
                  "RestrictPublicBuckets": false
                },
                "bucket_encryption": {
                  "Rules": [
                    {
                      "ApplyServerSideEncryptionByDefault": {
                        "SSEAlgorithm": "AES256"
                      },
                      "BucketKeyEnabled": false
                    }
                  ]
                },
                "OwnershipControls": {
                  "Rules": [
                    {
                      "ObjectOwnership": "BucketOwnerEnforced"
                    }
                  ]
                }
              }
            ],
            "PublicAccessBlockConfiguration_Account": [
              {
                "BlockPublicAcls": false,
                "IgnorePublicAcls": false,
                "BlockPublicPolicy": false,
                "RestrictPublicBuckets": false,
                "AccountID": "111111111111"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "익명 사용자(AllUsers)가 객체를 업로드/삭제할 수 있고 ACL 을 무시하는 차단 설정도 없으므로 퍼블릭 WRITE 허용 = 취약"
