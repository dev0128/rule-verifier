{
  "finding": "F146",
  "rule": "REME-0106000007",
  "service": "ecr",
  "status": "reproducible",
  "note": "ecr.py:388-396 — Allow 문장의 Principal 이 '*' 또는 {'AWS':'*'} 인지만 본다. 리포지토리 registryId(=소유 계정)와 비교하지 않아 다른 계정 ARN/계정 ID 허용을 놓치고, {'AWS':['*']} 리스트 형태도 놓친다.",
  "scenarios": [
    {
      "id": "other-account-root",
      "role": "bug",
      "condition": "Allow + Principal {'AWS': 'arn:aws:iam::222222222222:root'} (registryId=111111111111)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "ecr": {
            "describe_registry": [
              {
                "registryId": "111111111111",
                "replicationConfiguration": {
                  "rules": []
                }
              }
            ],
            "describe_repositories": [
              {
                "repositoryArn": "arn:aws:ecr:ap-northeast-2:111111111111:repository/shared",
                "registryId": "111111111111",
                "repositoryName": "shared",
                "repositoryUri": "111111111111.dkr.ecr.ap-northeast-2.amazonaws.com/shared",
                "createdAt": "2024-01-01T00:00:00+09:00",
                "imageTagMutability": "MUTABLE",
                "imageScanningConfiguration": {
                  "scanOnPush": false
                },
                "encryptionConfiguration": {
                  "encryptionType": "AES256"
                },
                "policyText": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": "s1",
                      "Effect": "Allow",
                      "Principal": {
                        "AWS": "arn:aws:iam::222222222222:root"
                      },
                      "Action": [
                        "ecr:BatchGetImage",
                        "ecr:GetDownloadUrlForLayer"
                      ]
                    }
                  ]
                },
                "lifecyclePolicyText": {}
              }
            ],
            "describe_images": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "소유 계정이 아닌 계정에 이미지 pull 을 허용 — 교차 계정 접근"
    },
