{
  "finding": "F029",
  "rule": "REME-0100500005",
  "service": "rds",
  "status": "reproducible",
  "note": "Raw/Service/rds.py:94 `item[\"DBClusters\"] = {}` 를 모든 인스턴스에 넣는데 Analyze/Service/rds.py:432 의 인스턴스 경로는 `get(\"DBClusters\") == None` 일 때만 점검한다({} == None 은 거짓) → 단독 인스턴스 점검 0건. 인스턴스 정보는 raw 에 그대로 있으므로 룰에서 고칠 수 있다(bug). (경로가 살아나도 F041 의 n/a 조건 결함이 남는다)",
  "scenarios": [
    {
      "id": "standalone-mysql-noaudit-export",
      "role": "bug",
      "condition": "단독(비클러스터) mysql 인스턴스 — 수집기 모양대로 DBClusters={}, EnabledCloudwatchLogsExports=[\"error\"]",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "rds": {
            "describe_db_instances": [
              {
                "DBInstanceIdentifier": "db-mysql",
                "DBInstanceArn": "arn:aws:rds:ap-northeast-2:111122223333:db:db-mysql",
                "DBInstanceClass": "db.t3.medium",
                "Engine": "mysql",
                "EngineVersion": "8.0.35",
                "DBInstanceStatus": "available",
                "Endpoint": {
                  "Address": "db-mysql.abc.ap-northeast-2.rds.amazonaws.com",
                  "Port": 3306,
                  "HostedZoneId": "Z1"
                },
                "MultiAZ": false,
                "PubliclyAccessible": false,
                "StorageEncrypted": true,
                "DeletionProtection": true,
                "BackupRetentionPeriod": 7,
                "MonitoringInterval": 0,
                "OptionGroupMemberships": [
                  {
                    "OptionGroupName": "default:mysql",
                    "Status": "in-sync"
                  }
                ],
                "DBParameterGroups": [
                  {
                    "DBParameterGroupName": "default.mysql",
                    "ParameterApplyStatus": "in-sync"
                  }
                ],
                "DBSubnetGroup": {
                  "DBSubnetGroupName": "dbsg-1",
                  "VpcId": "vpc-1",
                  "SubnetGroupStatus": "Complete",
                  "Subnets": [
                    {
                      "SubnetIdentifier": "subnet-a",
                      "SubnetAvailabilityZone": {
                        "Name": "ap-northeast-2a"
                      },
                      "SubnetStatus": "Active"
                    }
                  ]
                },
                "Tags": {},
                "DBClusters": {},
                "EnabledCloudwatchLogsExports": [
                  "error"
                ]
              }
            ],
            "describe_db_clusters": [],
            "describe_db_snapshots": [],
            "describe_db_cluster_snapshots": [],
            "describe_db_cluster_parameter_groups": [],
            "describe_db_parameter_groups": [],
            "describe_db_subnet_groups": [],
            "describe_option_groups": [],
            "describe_db_engine_versions": [
              {
                "account_id": "111122223333"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1,
        "flag_contains": [
          "db-mysql"
        ]
      },
      "why": "MySQL 인스턴스가 audit 로그를 내보내지 않으므로 취약(엔진의 클러스터 기준과 같은 판정). 빈 DBClusters 때문에 빠지면 안 된다"
    },
    {
      "id": "aurora-audit-export",
      "role": "control",
      "condition": "Aurora MySQL 클러스터, EnabledCloudwatchLogsExports=[\"audit\",\"error\"]",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "rds": {
            "describe_db_instances": [],
            "describe_db_clusters": [
              {
                "DBClusterIdentifier": "aurora-1",
                "DBClusterArn": "arn:aws:rds:ap-northeast-2:111122223333:cluster:aurora-1",
                "Engine": "aurora-mysql",
                "EngineVersion": "8.0.mysql_aurora.3.05.2",
                "Status": "available",
                "Port": 3306,
                "MultiAZ": false,
                "StorageEncrypted": true,
                "DeletionProtection": true,
                "BackupRetentionPeriod": 7,
                "DBSubnetGroup": "dbsg-1",
                "DBClusterParameterGroup": "cpg-aurora-1",
                "DBClusterMembers": [
                  {
                    "DBInstanceIdentifier": "aurora-1-i1",
                    "IsClusterWriter": true,
                    "DBClusterParameterGroupStatus": "in-sync",
                    "PromotionTier": 1
                  }
                ],
                "Tags": {},
                "EnabledCloudwatchLogsExports": [
                  "audit",
                  "error"
                ]
              }
            ],
            "describe_db_snapshots": [],
            "describe_db_cluster_snapshots": [],
            "describe_db_cluster_parameter_groups": [],
            "describe_db_parameter_groups": [],
            "describe_db_subnet_groups": [],
            "describe_option_groups": [],
            "describe_db_engine_versions": [
              {
                "account_id": "111122223333"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      }
    },
    {
      "id": "aurora-no-export",
      "role": "control",
      "condition": "Aurora MySQL 클러스터, 로그 내보내기 없음",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "rds": {
            "describe_db_instances": [],
            "describe_db_clusters": [
              {
                "DBClusterIdentifier": "aurora-1",
                "DBClusterArn": "arn:aws:rds:ap-northeast-2:111122223333:cluster:aurora-1",
                "Engine": "aurora-mysql",
                "EngineVersion": "8.0.mysql_aurora.3.05.2",
                "Status": "available",
                "Port": 3306,
                "MultiAZ": false,
                "StorageEncrypted": true,
                "DeletionProtection": true,
                "BackupRetentionPeriod": 7,
                "DBSubnetGroup": "dbsg-1",
                "DBClusterParameterGroup": "cpg-aurora-1",
                "DBClusterMembers": [
                  {
                    "DBInstanceIdentifier": "aurora-1-i1",
                    "IsClusterWriter": true,
                    "DBClusterParameterGroupStatus": "in-sync",
                    "PromotionTier": 1
                  }
                ],
                "Tags": {}
              }
            ],
            "describe_db_snapshots": [],
            "describe_db_cluster_snapshots": [],
            "describe_db_cluster_parameter_groups": [],
            "describe_db_parameter_groups": [],
            "describe_db_subnet_groups": [],
            "describe_option_groups": [],
            "describe_db_engine_versions": [
              {
                "account_id": "111122223333"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    }
  ]
