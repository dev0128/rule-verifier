                  },
                  "DomainValidationOptions": [
                    {
                      "DomainName": "*.example.com",
                      "ValidationDomain": "example.com",
                      "ValidationStatus": "SUCCESS",
                      "ValidationMethod": "DNS"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    },
    {
      "id": "imported-plain",
      "role": "control",
      "condition": "IMPORTED www.example.com (와일드카드 없음)",
