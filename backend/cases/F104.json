{
  "finding": "F104",
  "rule": "REME-0106200004",
  "service": "cloudtrail",
  "status": "reproducible",
  "note": "cloudtrail.py:243-254 — HomeRegion 필터가 없어 다중 리전 trail 이 수집된 리전마다(describe_trails 는 섀도 trail 을 돌려준다) 중복 점검. :277 고급 선택기는 resources.type 만 보고 readOnly 를 무시해 읽기 전용 선택기로도 '쓰기' 양호. CLT-006 도 같은 구조.",
  "scenarios": [
    {
      "id": "multi-region-duplicate",
      "role": "bug",
      "condition": "다중 리전 trail 1개(홈 ap-northeast-2, 관리 이벤트만)가 ap-northeast-2 · us-east-1 두 리전 describe_trails 에 모두 보임",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "cloudtrail": {
            "describe_trails": [
              {
                "Name": "multi",
                "S3BucketName": "trail-bucket",
                "IncludeGlobalServiceEvents": true,
                "IsMultiRegionTrail": true,
                "HomeRegion": "ap-northeast-2",
                "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/multi",
                "LogFileValidationEnabled": true,
                "HasCustomEventSelectors": false,
                "HasInsightSelectors": false,
                "IsOrganizationTrail": false,
                "TagsList": {},
                "trail_status": {
                  "IsLogging": true,
                  "LatestDeliveryTime": "2026-11-01T00:00:00Z",
                  "StartLoggingTime": "2026-01-01T00:00:00Z"
                },
                "EventSelectors": {
                  "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/multi",
                  "AdvancedEventSelectors": [
                    {
                      "Name": "sel0",
                      "FieldSelectors": [
                        {
                          "Field": "eventCategory",
                          "Equals": [
                            "Management"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "InsightSelectors": {}
              }
            ]
          }
        },
        "us-east-1": {
          "cloudtrail": {
            "describe_trails": [
              {
                "Name": "multi",
                "S3BucketName": "trail-bucket",
                "IncludeGlobalServiceEvents": true,
                "IsMultiRegionTrail": true,
                "HomeRegion": "ap-northeast-2",
                "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/multi",
                "LogFileValidationEnabled": true,
                "HasCustomEventSelectors": false,
                "HasInsightSelectors": false,
                "IsOrganizationTrail": false,
                "TagsList": {},
                "trail_status": {
                  "IsLogging": true,
                  "LatestDeliveryTime": "2026-11-01T00:00:00Z",
                  "StartLoggingTime": "2026-01-01T00:00:00Z"
                },
                "EventSelectors": {
                  "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/multi",
                  "AdvancedEventSelectors": [
                    {
                      "Name": "sel0",
                      "FieldSelectors": [
                        {
                          "Field": "eventCategory",
                          "Equals": [
                            "Management"
                          ]
                        }
                      ]
                    }
                  ]
                },
                "InsightSelectors": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 1,
        "flag": 1
      },
      "why": "trail 은 1개 — 홈 리전에서 한 번만 점검해야 한다(S3 데이터 이벤트가 없으니 취약 1건)"
    },
