{
  "finding": "F005",
  "rule": "REME-0102000002",
  "service": "cloudformation",
  "status": "reproducible",
  "note": "cloudformation.py:134 `\"Update:*\" in statement.get(\"Action\")` — Allow 문이 Action 대신 NotAction 을 쓰면 `in None` 으로 TypeError, 룰 전체 결과가 사라진다. 스택 정책 문법은 Action/NotAction 을 모두 지원한다(AWS CFN 사용자 가이드 'Stack policy syntax').",
  "scenarios": [
    {
      "id": "allow-notaction",
      "role": "bug",
      "condition": "stack-protected: {Deny Update:* ProductionDatabase} + {Allow NotAction Update:Delete Resource *}, stack-open: 스택 정책 없음",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "cloudformation": {
            "list_stacks": [
              {
                "StackId": "arn:aws:cloudformation:ap-northeast-2:111122223333:stack/stack-protected/0a1b2c3d",
                "StackName": "stack-protected",
                "StackStatus": "CREATE_COMPLETE",
                "CreationTime": "2026-01-01T00:00:00.000Z",
                "StackPolicyBody": {
                  "Statement": [
                    {
                      "Effect": "Deny",
                      "Action": "Update:*",
                      "Principal": "*",
                      "Resource": "LogicalResourceId/ProductionDatabase"
                    },
                    {
                      "Effect": "Allow",
                      "NotAction": "Update:Delete",
                      "Principal": "*",
                      "Resource": "*"
                    }
                  ]
                }
              },
              {
                "StackId": "arn:aws:cloudformation:ap-northeast-2:111122223333:stack/stack-open/0a1b2c3d",
                "StackName": "stack-open",
                "StackStatus": "CREATE_COMPLETE",
                "CreationTime": "2026-01-01T00:00:00.000Z",
                "StackPolicyBody": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 2,
        "flag": 1,
        "flag_contains": [
          "stack-open"
        ],
        "flag_excludes": [
          "stack-protected"
        ]
      },
      "why": "NotAction 은 정상 문법이라 룰이 죽으면 안 된다. stack-protected 는 삭제 업데이트를 막고 DB 를 보호하므로 양호, 정책 없는 stack-open 은 취약"
    },
    {
      "id": "action-form",
      "role": "control",
      "condition": "같은 두 스택, 보호 스택 정책을 Action 형태로만 작성 ({Deny Update:* ProductionDatabase} + {Allow Update:Modify Resource *})",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "cloudformation": {
            "list_stacks": [
              {
                "StackId": "arn:aws:cloudformation:ap-northeast-2:111122223333:stack/stack-protected/0a1b2c3d",
                "StackName": "stack-protected",
                "StackStatus": "CREATE_COMPLETE",
                "CreationTime": "2026-01-01T00:00:00.000Z",
                "StackPolicyBody": {
                  "Statement": [
                    {
                      "Effect": "Deny",
                      "Action": "Update:*",
                      "Principal": "*",
                      "Resource": "LogicalResourceId/ProductionDatabase"
                    },
                    {
                      "Effect": "Allow",
                      "Action": "Update:Modify",
                      "Principal": "*",
                      "Resource": "*"
                    }
                  ]
                }
              },
              {
                "StackId": "arn:aws:cloudformation:ap-northeast-2:111122223333:stack/stack-open/0a1b2c3d",
                "StackName": "stack-open",
                "StackStatus": "CREATE_COMPLETE",
                "CreationTime": "2026-01-01T00:00:00.000Z",
                "StackPolicyBody": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 2,
        "flag": 1,
        "flag_contains": [
          "stack-open"
        ]
      }
    }
  ]
}
