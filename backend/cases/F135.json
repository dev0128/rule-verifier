      "args": [],
      "raw": {
        "ap-northeast-2": {
          "elb": {
            "describe_load_balancers": [
              {
                "LoadBalancerName": "clb-ssl",
                "DNSName": "clb-ssl-1.ap-northeast-2.elb.amazonaws.com",
                "Scheme": "internet-facing",
                "ListenerDescriptions": [
                  {
                    "Listener": {
                      "Protocol": "SSL",
                      "LoadBalancerPort": 443,
                      "InstanceProtocol": "TCP",
                      "InstancePort": 80,
                      "SSLCertificateId": "arn:aws:acm:ap-northeast-2:111111111111:certificate/abc"
                    },
                    "PolicyNames": []
                  }
                ],
                "VPCId": "vpc-1",
                "Instances": [],
                "Tags": {},
                "PolicyDescriptions": [],
                "LoadBalancerAttributes": {
                  "CrossZoneLoadBalancing": {
                    "Enabled": true
                  },
                  "AccessLog": {
                    "Enabled": true,
                    "S3BucketName": "elb-logs",
                    "EmitInterval": 60
                  },
                  "ConnectionDraining": {
                    "Enabled": true,
                    "Timeout": 300
                  },
                  "ConnectionSettings": {
                    "IdleTimeout": 60
                  }
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      },
      "why": "SSL 리스너는 클라이언트-ELB 구간을 TLS 로 암호화한다(TCP over TLS) — 암호화 통신 양호"
