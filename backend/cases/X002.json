         "AllowedPrincipals": [{"PrincipalType": "Account", "Principal": "arn:aws:iam::222222222222:root", "ServicePermissionId": "vpce-svc-perm-3", "ServiceId": "vpce-svc-0ext"}]}
      ]}}},
