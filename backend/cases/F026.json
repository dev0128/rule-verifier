                "Path": "/",
                "DefaultVersionId": "v1",
                "AttachmentCount": 1,
                "IsAttachable": true,
                "CreateDate": "2020-01-01 00:00:00+00:00",
                "Document": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Action": [
                        "iam:PassRole",
                        "ec2:RunInstances"
                      ],
                      "Resource": "*"
                    }
                  ]
                },
                "VersionId": "v1",
                "IsDefaultVersion": true
              }
            ]
          }
        }
