      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    },
    {
      "id": "s3-read-only",
      "role": "control",
      "condition": "고객 관리형 정책 Allow s3:GetObject 만",
      "args": [],
      "raw": {
        "globals": {
          "iam": {
            "list_policies": [
              {
                "PolicyName": "s3-read",
                "PolicyId": "ANPAS3READ",
                "Arn": "arn:aws:iam::111111111111:policy/s3-read",
                "Path": "/",
                "DefaultVersionId": "v1",
                "AttachmentCount": 1,
                "IsAttachable": true,
                "CreateDate": "2020-01-01 00:00:00+00:00",
