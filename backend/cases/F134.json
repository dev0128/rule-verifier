                "LoadBalancerName": "alb-mixed",
                "Scheme": "internet-facing",
                "VpcId": "vpc-1",
                "State": {
                  "Code": "active"
                },
                "Type": "application",
                "IpAddressType": "ipv4",
                "Attributes": [],
                "Listeners": [
                  {
                    "Port": 80,
                    "Protocol": "HTTP",
                    "DefaultActions": [
                      {
                        "Type": "forward",
                        "TargetGroupArn": "arn:aws:elasticloadbalancing:ap-northeast-2:111111111111:targetgroup/tg/0123456789abcdef",
