{
  "finding": "F134",
  "rule": "REME-0100800007",
  "service": "elb",
  "status": "reproducible",
  "effect": "wrong_logic",
  "note": "elb.py:405-412 — ALB 는 HTTPS 리스너가 하나라도 있으면 HTTP forward 리스너가 있어도 양호. HTTP→HTTPS redirect 판정은 `Type != \"redirect\"` 로 반전돼 RedirectConfig 를 가진 액션에 도달하지 못한다. 미탐(a)과 오탐(b)이 함께 있어 effect 를 wrong_logic 으로 바로잡음.",
  "scenarios": [
    {
      "id": "http-forward-plus-https",
      "role": "bug",
      "condition": "ALB 리스너 [HTTP:80 forward(평문으로 대상에 전달), HTTPS:443 forward]",
      "args": [],
      "raw": {
