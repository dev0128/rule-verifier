{
  "finding": "F126",
  "rule": "REME-0101300007",
  "service": "elasticbeanstalk",
  "status": "reproducible",
  "note": "elasticbeanstalk.py:416-422 — ResourceName=AWSEBV2LoadBalancerListener(:80 기본 리스너)의 Protocol 만 보고, Green 환경만 판정. :443 HTTPS 리스너를 둔 ALB 도 취약, CLB · 비Green 은 검사 없이 양호.",
  "scenarios": [
    {
      "id": "alb-80http-443https",
      "role": "bug",
      "condition": "Health=Green ALB 환경, :80 기본 리스너 HTTP + :443 리스너(AWSEBV2LoadBalancerListener443) HTTPS",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "elasticbeanstalk": {
            "describe_environments": [
              {
                "EnvironmentName": "env-alb",
                "EnvironmentId": "e-env-alb",
                "ApplicationName": "app",
                "VersionLabel": "v1",
                "SolutionStackName": "64bit Amazon Linux 2023 v4.3.0 running Python 3.11",
                "PlatformArn": "arn:aws:elasticbeanstalk:ap-northeast-2::platform/Python 3.11 running on 64bit Amazon Linux 2023/4.3.0",
                "EndpointURL": "env-alb.ap-northeast-2.elb.amazonaws.com",
                "CNAME": "env-alb.ap-northeast-2.elasticbeanstalk.com",
