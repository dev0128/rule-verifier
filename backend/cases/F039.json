                    "Origin": "CreateRoute",
                    "State": "active"
                  }
                ],
                "Tags": []
              },
              {
                "RouteTableId": "rtb-private",
                "VpcId": "vpc-1",
                "OwnerId": "111111111111",
                "Associations": [
                  {
                    "Main": false,
                    "RouteTableAssociationId": "rtbassoc-subnet-priv",
                    "RouteTableId": "rtb-private",
                    "SubnetId": "subnet-priv",
                    "AssociationState": {
                      "State": "associated"
                    }
                  },
                  {
                    "Main": true,
                    "RouteTableAssociationId": "rtbassoc-main",
                    "RouteTableId": "rtb-private",
                    "AssociationState": {
                      "State": "associated"
                    }
                  }
                ],
                "Routes": [
                  {
                    "DestinationCidrBlock": "10.0.0.0/16",
                    "GatewayId": "local",
                    "Origin": "CreateRouteTable",
                    "State": "active"
                  }
                ],
                "Tags": []
              }
            ]
