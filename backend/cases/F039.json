                  "Subnets": [
                    {
                      "SubnetIdentifier": "subnet-pub"
                    }
                  ]
                },
                "PubliclyAccessible": false,
                "DBClusters": {
                  "DBClusterIdentifier": "npt-1",
                  "Engine": "neptune"
                }
              }
            ]
          },
          "ec2": {
            "describe_route_tables": [
              {
                "RouteTableId": "rtb-public",
                "VpcId": "vpc-1",
