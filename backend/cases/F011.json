                "DomainName": "example.com",
                "AutoRenew": false,
                "AdminPrivacy": true,
                "RegistrantPrivacy": true,
                "TechPrivacy": true,
                "ExpirationDate": "2099-01-01 00:00:00+00:00",
                "TransferLock": true,
                "Expiry": "2099-01-01 00:00:00+00:00",
                "StatusList": [
