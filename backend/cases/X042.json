{
  "finding": "X042",
  "rule": "REME-0101700001",
  "service": "athena",
  "status": "reproducible",
  "note": "athena.py:69-72 — 작업 그룹 ResultConfiguration 의 EncryptionOption 만 보고 EnforceWorkGroupConfiguration 을 보지 않는다. 강제하지 않으면(false) 클라이언트 쪽 쿼리 설정이 작업 그룹 설정을 덮어써 암호화 없이 결과를 저장할 수 있다(EnableMinimumEncryptionConfiguration 으로 최소 암호화를 강제한 경우는 예외).",
  "scenarios": [
    {
      "id": "not-enforced",
      "role": "bug",
      "condition": "작업 그룹에 SSE_S3 가 설정됐지만 EnforceWorkGroupConfiguration=false, 최소 암호화 강제 없음",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "athena": {
            "get_work_group": [
              {
                "Name": "loose",
                "State": "ENABLED",
                "Configuration": {
                  "EnforceWorkGroupConfiguration": false,
                  "PublishCloudWatchMetricsEnabled": true,
                  "RequesterPaysEnabled": false,
                  "EngineVersion": {
                    "SelectedEngineVersion": "AUTO",
                    "EffectiveEngineVersion": "Athena engine version 3"
                  },
                  "ResultConfiguration": {
                    "OutputLocation": "s3://athena-results-111111111111/loose/",
                    "EncryptionConfiguration": {
                      "EncryptionOption": "SSE_S3"
                    }
                  }
                },
                "Description": "",
                "CreationTime": "2025-01-01T00:00:00+00:00",
                "Tags": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "작업 그룹 설정을 강제하지 않으면 클라이언트가 결과 위치 · 암호화를 직접 지정할 수 있어(AWS 문서: Override client-side settings 꺼짐) 암호화가 보장되지 않는다"
    },
    {
      "id": "not-enforced-min-encryption",
      "role": "control",
      "condition": "EnforceWorkGroupConfiguration=false 지만 EnableMinimumEncryptionConfiguration=true, SSE_S3",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "athena": {
            "get_work_group": [
              {
                "Name": "minenc",
                "State": "ENABLED",
                "Configuration": {
                  "EnforceWorkGroupConfiguration": false,
                  "PublishCloudWatchMetricsEnabled": true,
                  "RequesterPaysEnabled": false,
                  "EngineVersion": {
                    "SelectedEngineVersion": "AUTO",
                    "EffectiveEngineVersion": "Athena engine version 3"
                  },
                  "ResultConfiguration": {
                    "OutputLocation": "s3://athena-results-111111111111/minenc/",
                    "EncryptionConfiguration": {
                      "EncryptionOption": "SSE_S3"
                    }
                  },
                  "EnableMinimumEncryptionConfiguration": true
                },
                "Description": "",
                "CreationTime": "2025-01-01T00:00:00+00:00",
                "Tags": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      },
      "why": "최소 암호화 강제로 클라이언트가 이보다 약한(무암호화) 설정을 쓸 수 없다"
    },
