                        "awslogs-group": "/ecs/fam",
                        "awslogs-region": "ap-northeast-2",
                        "awslogs-stream-prefix": "app"
                      }
                    },
                    "family": "fam"
                  }
                ],
                "dclo_id": "ap-northeast-2.ecs.taskdefinition.fam",
