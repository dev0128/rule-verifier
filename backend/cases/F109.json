                      "Effect": "Allow",
                      "Principal": "*",
                      "Action": "lambda:InvokeFunction",
                      "Resource": "arn:aws:lambda:ap-northeast-2:111122223333:function:f1"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    },
    {
      "id": "service-principal",
