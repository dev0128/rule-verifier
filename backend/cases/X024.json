{
  "finding": "X024",
  "rule": "REME-0100100016",
  "service": "iam",
  "status": "reproducible",
  "note": "iam.py:12-35 is_service_role — 신뢰 정책에 Service 주체를 Allow 하는 문이 하나라도 있으면 서비스 역할로 보고 IAM-016·018 대상에서 통째로 뺀다. 같은 신뢰 정책에 AWS 주체(타 계정)도 있는 역할을 놓친다.",
  "scenarios": [
    {
      "id": "ro-service-and-external-stmts",
      "role": "bug",
      "condition": "[IAM-016] ReadOnlyAccess 역할, 신뢰 정책 문 2개 — Service ec2.amazonaws.com + AWS 외부 계정 222222222222",
      "args": [],
      "raw": {
        "globals": {
          "iam": {
            "list_roles": [
              {
                "RoleName": "ro-mixed",
                "RoleId": "AROAROMIXED",
                "Arn": "arn:aws:iam::111111111111:role/ro-mixed",
                "Path": "/",
                "CreateDate": "2020-01-01 00:00:00+00:00",
                "MaxSessionDuration": 3600,
                "AssumeRolePolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "Service": "ec2.amazonaws.com"
                      },
                      "Action": "sts:AssumeRole"
                    },
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "AWS": "arn:aws:iam::222222222222:root"
                      },
                      "Action": "sts:AssumeRole"
                    }
                  ]
                },
                "policies": [
                  {
                    "PolicyName": "ReadOnlyAccess",
                    "PolicyArn": "arn:aws:iam::aws:policy/ReadOnlyAccess"
                  }
                ],
                "inline_policies": [],
                "Tags": {}
              }
            ]
          },
          "account": {
            "get_owner_id": [
              {
                "OwnerId": "111111111111"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1,
        "flag_contains": [
          "ro-mixed"
        ]
      },
      "why": "서비스 주체가 함께 있어도 외부 계정이 역할을 맡을 수 있으므로 외부 계정 ReadOnlyAccess 부여에 해당"
    },
    {
      "id": "ro-service-and-external-one-stmt",
      "role": "bug",
