{
  "finding": "F060",
  "rule": "REME-0101800002",
  "service": "autoscaling",
  "status": "reproducible",
  "note": "autoscaling.py:100 — AvailabilityZones 개수만 본다(<=1 이면 취약). 항목명 '여러 AZ 에 걸쳐 여러 인스턴스 유형' 의 인스턴스 유형 수(MixedInstancesPolicy.LaunchTemplate.Overrides)는 보지 않는다. 카탈로그 confidence low — 판단기준 원문 확인 필요.",
  "scenarios": [
    {
      "id": "multi-az-single-type",
      "role": "bug",
      "condition": "AZ 2개, 단일 LaunchTemplate(인스턴스 유형 m5.large 1종)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "autoscaling": {
            "describe_auto_scaling_groups": [
              {
                "AutoScalingGroupName": "asg-web",
                "AutoScalingGroupARN": "arn:aws:autoscaling:ap-northeast-2:111122223333:autoScalingGroup:x:autoScalingGroupName/asg-web",
                "MinSize": 1,
                "MaxSize": 2,
                "DesiredCapacity": 1,
                "AvailabilityZones": [
                  "ap-northeast-2a",
                  "ap-northeast-2c"
                ],
                "Instances": [],
                "Tags": {},
                "LaunchTemplate": {
                  "LaunchTemplateId": "lt-0a1",
                  "LaunchTemplateName": "lt-0a1-name",
                  "Version": "1",
                  "LaunchTemplateVersions": {
                    "LaunchTemplateId": "lt-0a1",
                    "LaunchTemplateName": "lt-0a1-name",
                    "VersionNumber": 1,
                    "DefaultVersion": true,
                    "LaunchTemplateData": {
                      "ImageId": "ami-0abc",
                      "InstanceType": "m5.large"
                    }
                  }
                }
              }
            ],
            "describe_launch_configurations": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "항목명대로라면 여러 AZ 이면서 여러 인스턴스 유형이어야 양호 — 유형이 1종이면 용량 부족 시 대체 유형이 없어 취약"
