{
  "finding": "F088",
  "rule": "REME-0100700011",
  "service": "s3",
  "status": "reproducible",
  "note": "s3.py:651 — IgnorePublicAcls AND RestrictPublicBuckets 가 둘 다 true 여야 ACL 검사를 건너뛴다. ACL 노출은 IgnorePublicAcls 하나로 무력화된다(S3-017 s3.py:1019 동일).",
  "scenarios": [
    {
      "id": "ignore-acls-only",
      "role": "bug",
      "condition": "AllUsers READ ACL 이 남아 있고 IgnorePublicAcls=true, RestrictPublicBuckets=false",
      "args": [],
      "raw": {
        "globals": {
          "s3": {
            "list_buckets": [
              {
                "Name": "ignore-acl",
                "CreationDate": "2024-01-01T00:00:00+00:00",
                "LocationConstraint": "ap-northeast-2",
                "bucket_versioning": {
                  "Status": "Enabled",
                  "MFADelete": null
                },
                "Grants": [
                  {
                    "Grantee": {
                      "Type": "CanonicalUser",
                      "ID": "abc123owner",
                      "DisplayName": "owner"
                    },
                    "Permission": "FULL_CONTROL"
                  },
                  {
                    "Grantee": {
                      "Type": "Group",
                      "URI": "http://acs.amazonaws.com/groups/global/AllUsers"
                    },
                    "Permission": "READ"
                  }
                ],
                "Policy": {},
                "PolicyStatus": {},
                "PublicAccessBlockConfiguration": {
                  "BlockPublicAcls": true,
                  "IgnorePublicAcls": true,
                  "BlockPublicPolicy": false,
                  "RestrictPublicBuckets": false
                },
                "bucket_encryption": {
                  "Rules": [
                    {
                      "ApplyServerSideEncryptionByDefault": {
                        "SSEAlgorithm": "AES256"
                      },
                      "BucketKeyEnabled": false
                    }
                  ]
                },
                "OwnershipControls": {
                  "Rules": [
                    {
                      "ObjectOwnership": "BucketOwnerEnforced"
                    }
                  ]
                }
              }
            ],
            "PublicAccessBlockConfiguration_Account": [
              {
                "BlockPublicAcls": false,
                "IgnorePublicAcls": false,
                "BlockPublicPolicy": false,
                "RestrictPublicBuckets": false,
                "AccountID": "111111111111"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      },
      "why": "IgnorePublicAcls=true 면 S3 가 버킷·객체의 퍼블릭 ACL 을 모두 무시한다(AWS 문서). RestrictPublicBuckets 는 정책 쪽 설정이라 ACL 노출과 무관"
    },
