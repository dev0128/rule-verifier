                "ResourceRecordSets": [
                  {
                    "Name": "ok.z1.example.com.",
                    "Type": "A",
                    "TTL": 300,
                    "ResourceRecords": [
                      {
                        "Value": "13.125.1.1"
                      }
                    ]
                  },
                  {
                    "Name": "old.z1.example.com.",
                    "Type": "A",
                    "TTL": 300,
                    "ResourceRecords": [
                      {
                        "Value": "52.79.9.9"
                      }
                    ]
                  }
                ],
                "Tags": {}
              }
            ],
            "list_query_logging_configs": [],
            "get_domain_detail": []
          },
          "account": {
            "get_owner_id": [
              {
                "OwnerId": "111122223333"
              }
            ]
          }
        },
        "ap-northeast-2": {
          "ec2": {
            "describe_addresses": [
              {
                "PublicIp": "13.125.1.1",
                "AllocationId": "eipalloc-0",
                "Domain": "vpc"
              }
            ],
            "describe_instances": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 1,
        "flag": 1,
        "good": 0
      },
      "why": "결과 행 단위는 호스팅 영역(id=영역 이름)이다. dangling 레코드가 있는 영역은 취약 1건이어야 하고 같은 영역이 양호로도 집계되면 안 된다"
    },
