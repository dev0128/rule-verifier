{
  "finding": "F085",
  "rule": "REME-0100700007",
  "service": "s3",
  "status": "reproducible",
  "note": "s3.py:400-401 — Effect Allow 문장에 Principal 대신 NotPrincipal 을 쓰면 Principal=None → None.get 으로 AttributeError, 룰 전체 예외(006~010 동일).",
  "scenarios": [
    {
      "id": "notprincipal-allow",
      "role": "bug",
      "condition": "버킷 2개: ① Allow + NotPrincipal(특정 role) + s3:GetObject ② Principal '*' + s3:GetObject 공개 버킷",
      "args": [],
      "raw": {
        "globals": {
          "s3": {
            "list_buckets": [
              {
                "Name": "notprincipal",
                "CreationDate": "2024-01-01T00:00:00+00:00",
                "LocationConstraint": "ap-northeast-2",
                "bucket_versioning": {
                  "Status": "Enabled",
                  "MFADelete": null
                },
                "Grants": [
                  {
                    "Grantee": {
                      "Type": "CanonicalUser",
                      "ID": "abc123owner",
                      "DisplayName": "owner"
                    },
                    "Permission": "FULL_CONTROL"
                  }
                ],
                "Policy": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "NotPrincipal": {
                        "AWS": "arn:aws:iam::111111111111:role/blocked"
                      },
                      "Action": "s3:GetObject",
                      "Resource": "arn:aws:s3:::b/*"
                    }
                  ]
                },
                "PolicyStatus": {},
                "PublicAccessBlockConfiguration": {
                  "BlockPublicAcls": false,
                  "IgnorePublicAcls": false,
                  "BlockPublicPolicy": false,
                  "RestrictPublicBuckets": false
                },
                "bucket_encryption": {
                  "Rules": [
                    {
                      "ApplyServerSideEncryptionByDefault": {
                        "SSEAlgorithm": "AES256"
                      },
                      "BucketKeyEnabled": false
                    }
                  ]
                },
                "OwnershipControls": {
                  "Rules": [
                    {
                      "ObjectOwnership": "BucketOwnerEnforced"
                    }
                  ]
                }
              },
              {
                "Name": "public-get",
                "CreationDate": "2024-01-01T00:00:00+00:00",
                "LocationConstraint": "ap-northeast-2",
                "bucket_versioning": {
                  "Status": "Enabled",
                  "MFADelete": null
                },
                "Grants": [
                  {
                    "Grantee": {
                      "Type": "CanonicalUser",
                      "ID": "abc123owner",
                      "DisplayName": "owner"
                    },
                    "Permission": "FULL_CONTROL"
                  }
                ],
                "Policy": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": "*",
                      "Action": "s3:GetObject",
                      "Resource": "arn:aws:s3:::b/*"
                    }
                  ]
                },
                "PolicyStatus": {},
                "PublicAccessBlockConfiguration": {
                  "BlockPublicAcls": false,
                  "IgnorePublicAcls": false,
                  "BlockPublicPolicy": false,
                  "RestrictPublicBuckets": false
                },
                "bucket_encryption": {
                  "Rules": [
                    {
                      "ApplyServerSideEncryptionByDefault": {
                        "SSEAlgorithm": "AES256"
                      },
                      "BucketKeyEnabled": false
                    }
                  ]
                },
                "OwnershipControls": {
                  "Rules": [
                    {
                      "ObjectOwnership": "BucketOwnerEnforced"
                    }
                  ]
                }
              }
            ],
            "PublicAccessBlockConfiguration_Account": [
              {
                "BlockPublicAcls": false,
                "IgnorePublicAcls": false,
                "BlockPublicPolicy": false,
                "RestrictPublicBuckets": false,
                "AccountID": "111111111111"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "checked": 2,
        "flag": 2,
        "flag_contains": [
          "public-get"
        ]
      },
      "why": "Allow + NotPrincipal 은 '나열한 주체를 뺀 모든 주체(익명 포함)' 에게 GetObject 를 허용하는 사실상 공개 정책이다. 예외 없이 두 버킷 모두 판정되어야 한다"
    },
    {
