                  {
                    "PolicyName": "send-auth",
                    "Version": "2012-10-17",
                    "Statement": [
                      {
                        "Sid": "s1",
                        "Effect": "Deny",
                        "NotPrincipal": {
                          "AWS": "arn:aws:iam::111122223333:root"
                        },
                        "Action": [
                          "ses:SendEmail",
                          "ses:SendRawEmail"
                        ],
                        "Resource": "arn:aws:ses:ap-northeast-2:111122223333:identity/a.example.com"
                      }
                    ]
                  }
                ]
              },
              {
                "IdentityType": "Domain",
                "Identity": "partner.example.com",
                "Policies": [
                  {
                    "PolicyName": "send-auth",
                    "Version": "2012-10-17",
                    "Statement": [
                      {
                        "Sid": "s1",
                        "Effect": "Allow",
                        "Principal": {
                          "AWS": "arn:aws:iam::999999999999:root"
                        },
                        "Action": [
                          "ses:SendEmail",
                          "ses:SendRawEmail"
                        ],
                        "Resource": "arn:aws:ses:ap-northeast-2:111122223333:identity/partner.example.com"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        }
      },
      "expect": {
