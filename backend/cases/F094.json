{
  "finding": "F094",
  "rule": "REME-0106200001",
  "service": "cloudtrail",
  "status": "reproducible",
  "note": "cloudtrail.py:105-108 — 클래식 EventSelectors 에 ExcludeManagementEventSources == [] 가 있으면 flag=False 로 덮어써 IsLogging · IsMultiRegionTrail · IncludeManagementEvents 판정이 모두 무효. AWS 는 클래식 선택기에 이 키를 항상 [] 로 돌려준다.",
  "scenarios": [
    {
      "id": "classic-stopped",
      "role": "bug",
      "condition": "클래식 이벤트 선택기 trail, IsLogging=false(로깅 중지), 다중 리전, 관리 이벤트 기록",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "cloudtrail": {
            "describe_trails": [
              {
                "Name": "main",
                "S3BucketName": "trail-bucket",
                "IncludeGlobalServiceEvents": true,
                "IsMultiRegionTrail": true,
                "HomeRegion": "ap-northeast-2",
                "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/main",
                "LogFileValidationEnabled": true,
                "HasCustomEventSelectors": false,
                "HasInsightSelectors": false,
                "IsOrganizationTrail": false,
                "TagsList": {},
                "trail_status": {
                  "IsLogging": false,
                  "LatestDeliveryTime": "2026-11-01T00:00:00Z",
                  "StartLoggingTime": "2026-01-01T00:00:00Z",
                  "StopLoggingTime": "2026-10-01T00:00:00Z"
                },
                "EventSelectors": {
                  "TrailARN": "arn:aws:cloudtrail:ap-northeast-2:111122223333:trail/main",
                  "EventSelectors": [
                    {
                      "ReadWriteType": "All",
                      "IncludeManagementEvents": true,
                      "DataResources": [],
                      "ExcludeManagementEventSources": []
                    }
                  ]
                },
                "InsightSelectors": {}
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "로깅이 중지된 trail 은 활성화된 것이 아니다"
    },
