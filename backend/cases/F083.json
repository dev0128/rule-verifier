{
  "finding": "F083",
  "rule": "REME-0100700002",
  "service": "s3",
  "status": "reproducible",
  "note": "s3.py:95-101 — 어느 Statement 든 Condition.Bool 에 aws:SecureTransport 키만 있으면 Effect/값과 무관하게 양호. else 분기(s3.py:111)는 Effect 를 Condition 에서 읽어 사실상 죽은 코드.",
  "scenarios": [
    {
      "id": "allow-true-only",
      "role": "bug",
      "condition": "Allow + Bool aws:SecureTransport='true' 문장만 있고 HTTP 를 막는 Deny 문장이 없는 정책 (ALB/액세스 로그 버킷 형태)",
      "args": [],
      "raw": {
        "globals": {
          "s3": {
            "list_buckets": [
              {
                "Name": "alb-logs",
                "CreationDate": "2024-01-01T00:00:00+00:00",
                "LocationConstraint": "ap-northeast-2",
                "bucket_versioning": {
                  "Status": "Enabled",
                  "MFADelete": null
                },
                "Grants": [
                  {
                    "Grantee": {
                      "Type": "CanonicalUser",
                      "ID": "abc123owner",
                      "DisplayName": "owner"
                    },
                    "Permission": "FULL_CONTROL"
                  }
                ],
                "Policy": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Sid": "AWSLogDeliveryWrite",
                      "Effect": "Allow",
                      "Principal": {
                        "Service": "delivery.logs.amazonaws.com"
                      },
                      "Action": "s3:PutObject",
                      "Resource": "arn:aws:s3:::b/*",
                      "Condition": {
                        "Bool": {
                          "aws:SecureTransport": "true"
                        }
                      }
                    }
                  ]
                },
                "PolicyStatus": {},
                "PublicAccessBlockConfiguration": {
                  "BlockPublicAcls": false,
                  "IgnorePublicAcls": false,
                  "BlockPublicPolicy": false,
                  "RestrictPublicBuckets": false
                },
                "bucket_encryption": {
                  "Rules": [
                    {
                      "ApplyServerSideEncryptionByDefault": {
                        "SSEAlgorithm": "AES256"
                      },
                      "BucketKeyEnabled": false
                    }
                  ]
                },
                "OwnershipControls": {
                  "Rules": [
                    {
                      "ObjectOwnership": "BucketOwnerEnforced"
                    }
                  ]
                }
              }
            ],
            "PublicAccessBlockConfiguration_Account": [
              {
                "BlockPublicAcls": false,
                "IgnorePublicAcls": false,
                "BlockPublicPolicy": false,
                "RestrictPublicBuckets": false,
                "AccountID": "111111111111"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "Allow+SecureTransport=true 는 HTTPS 요청에만 권한을 더 줄 뿐 HTTP 요청을 거부하지 않는다. SSL 강제는 Effect=Deny + aws:SecureTransport=false 문장이 있어야 한다"
    },
    {
      "id": "deny-false",
      "role": "control",
      "condition": "Deny + Action s3:* + Bool aws:SecureTransport='false' 정책",
      "args": [],
      "raw": {
        "globals": {
          "s3": {
            "list_buckets": [
              {
                "Name": "ssl-only",
                "CreationDate": "2024-01-01T00:00:00+00:00",
