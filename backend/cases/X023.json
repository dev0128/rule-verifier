                "access_key_2_last_used_service": "N/A",
                "cert_1_active": "false",
                "cert_1_last_rotated": "N/A",
                "cert_2_active": "false",
                "cert_2_last_rotated": "N/A"
              },
              {
                "user": "user-b",
                "arn": "arn:aws:iam::111111111111:user/user-b",
                "user_creation_time": "2020-01-01T00:00:00+00:00",
                "password_enabled": "false",
                "password_last_used": "N/A",
                "password_last_changed": "N/A",
                "password_next_rotation": "N/A",
                "mfa_active": "false",
                "access_key_1_active": "false",
                "access_key_1_last_rotated": "N/A",
                "access_key_1_last_used_date": "N/A",
                "access_key_1_last_used_region": "N/A",
                "access_key_1_last_used_service": "N/A",
                "access_key_2_active": "true",
                "access_key_2_last_rotated": "2020-01-01T00:00:00+00:00",
                "access_key_2_last_used_date": "N/A",
                "access_key_2_last_used_region": "N/A",
                "access_key_2_last_used_service": "N/A",
                "cert_1_active": "false",
                "cert_1_last_rotated": "N/A",
                "cert_2_active": "false",
                "cert_2_last_rotated": "N/A"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 2,
        "flag_contains": [
          "user-a",
          "user-b"
        ]
      },
      "why": "같은 자격증명 상태면 같은 판정이어야 한다. 90일 넘게 한 번도 안 쓴 활성 키는 '사용하지 않은 자격증명' 이므로 둘 다 취약"
    },
