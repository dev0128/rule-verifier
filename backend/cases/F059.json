{
  "finding": "F059",
  "rule": "REME-0105100001",
  "service": "securityhub",
  "status": "reproducible",
  "note": "securityhub.py:32-35 — HubArn 유무만 본다. 같은 리전 raw 에 수집된 get_enabled_standards(StandardsSubscriptions)를 쓰지 않아 표준 미구독을 놓친다.",
  "scenarios": [
    {
      "id": "hub-no-standards",
      "role": "bug",
      "condition": "Security Hub 활성(HubArn 있음), 구독한 보안 표준 0개(get_enabled_standards=[])",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "securityhub": {
            "describe_hub": [
              {
                "HubArn": "arn:aws:securityhub:ap-northeast-2:111122223333:hub/default",
                "SubscribedAt": "2026-01-01T00:00:00.000Z",
                "AutoEnableControls": true,
                "ControlFindingGenerator": "SECURITY_CONTROL"
              }
            ],
            "get_enabled_standards": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      },
      "why": "항목명 '활성화 및 표준 구독' — 표준을 하나도 구독하지 않으면 보안 점검(컨트롤)이 돌지 않으므로 취약"
    },
    {
      "id": "hub-with-standard",
      "role": "control",
      "condition": "Security Hub 활성 + AWS FSBP 표준 구독(StandardsStatus=READY)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "securityhub": {
            "describe_hub": [
              {
                "HubArn": "arn:aws:securityhub:ap-northeast-2:111122223333:hub/default",
                "SubscribedAt": "2026-01-01T00:00:00.000Z",
                "AutoEnableControls": true,
                "ControlFindingGenerator": "SECURITY_CONTROL"
              }
            ],
            "get_enabled_standards": [
              {
                "StandardsSubscriptionArn": "arn:aws:securityhub:ap-northeast-2:111122223333:subscription/aws-foundational-security-best-practices/v/1.0.0",
                "StandardsArn": "arn:aws:securityhub:ap-northeast-2::standards/aws-foundational-security-best-practices/v/1.0.0",
                "StandardsInput": {},
                "StandardsStatus": "READY"
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1
      }
    },
    {
      "id": "hub-disabled",
      "role": "control",
      "condition": "Security Hub 미활성(describe_hub 빈 리스트)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "securityhub": {
            "describe_hub": [],
            "get_enabled_standards": []
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    }
  ]
}
