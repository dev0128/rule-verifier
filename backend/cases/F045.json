{
  "finding": "F045",
  "rule": "REME-0105900005",
  "service": "eks",
  "status": "reproducible",
  "note": "Analyze/eks.py:323-330 — 클러스터 서비스 역할(roleArn)의 신뢰 정책만 본다. 클러스터 역할은 EKS 요구사항상 항상 Principal.Service=eks.amazonaws.com 이고 Federated 가 없으므로 모든 클러스터가 취약. OIDC issuer(identity.oidc) · OIDC 공급자를 Federated 로 신뢰하는 IRSA 역할은 보지 않는다.",
  "scenarios": [
    {
      "id": "irsa-configured",
      "role": "bug",
      "condition": "클러스터에 OIDC issuer 가 있고, 그 OIDC 공급자를 Federated 로 신뢰하는 IRSA 역할(app-irsa)이 존재",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "eks": {
            "describe_cluster": [
              {
                "name": "c1",
                "arn": "arn:aws:eks:ap-northeast-2:111122223333:cluster/c1",
                "version": "1.31",
                "roleArn": "arn:aws:iam::111122223333:role/eks-cluster-role",
                "resourcesVpcConfig": {
                  "subnetIds": [
                    "subnet-a",
                    "subnet-b"
                  ],
                  "securityGroupIds": [],
                  "clusterSecurityGroupId": "sg-cluster",
                  "vpcId": "vpc-1",
                  "endpointPublicAccess": false,
                  "endpointPrivateAccess": true,
                  "publicAccessCidrs": [
                    "0.0.0.0/0"
                  ]
                },
                "logging": {
                  "clusterLogging": [
                    {
                      "types": [
                        "api",
                        "audit",
                        "authenticator",
                        "controllerManager",
                        "scheduler"
                      ],
                      "enabled": true
                    }
                  ]
                },
                "status": "ACTIVE",
                "nodegroups": [],
                "fargateProfile": [],
                "updateRecodes": [],
                "clusterRole_EvaluationResults": {
                  "EvalActionName": "eks:*",
                  "EvalResourceName": "*",
                  "EvalDecision": "implicitDeny"
                },
                "identity": {
                  "oidc": {
                    "issuer": "https://oidc.eks.ap-northeast-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE"
                  }
                }
              }
            ]
          },
          "ec2": {
            "describe_security_groups": [],
            "describe_vpcs": []
          }
        },
        "globals": {
          "iam": {
            "list_roles": [
              {
                "RoleName": "eks-cluster-role",
                "Arn": "arn:aws:iam::111122223333:role/eks-cluster-role",
                "AssumeRolePolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "Service": "eks.amazonaws.com"
                      },
                      "Action": "sts:AssumeRole"
                    }
                  ]
                }
              },
              {
                "RoleName": "app-irsa",
                "Arn": "arn:aws:iam::111122223333:role/app-irsa",
                "AssumeRolePolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "Federated": "arn:aws:iam::111122223333:oidc-provider/oidc.eks.ap-northeast-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE"
                      },
                      "Action": "sts:AssumeRoleWithWebIdentity",
                      "Condition": {
                        "StringEquals": {
                          "oidc.eks.ap-northeast-2.amazonaws.com/id/EXAMPLED539D4633E53DE1B71EXAMPLE:sub": "system:serviceaccount:default:app"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Secure",
        "good": 1,
        "flag": 0
      },
      "why": "IRSA 는 클러스터 OIDC 공급자 + sts:AssumeRoleWithWebIdentity 로 신뢰하는 역할로 구성된다. 클러스터 서비스 역할 신뢰 정책은 IRSA 와 무관하다"
    },
    {
      "id": "no-oidc",
      "role": "control",
      "condition": "OIDC issuer 없음, IRSA 역할 없음 (클러스터 역할만 존재)",
      "args": [],
      "raw": {
        "ap-northeast-2": {
          "eks": {
            "describe_cluster": [
              {
                "name": "c1",
                "arn": "arn:aws:eks:ap-northeast-2:111122223333:cluster/c1",
                "version": "1.31",
                "roleArn": "arn:aws:iam::111122223333:role/eks-cluster-role",
                "resourcesVpcConfig": {
                  "subnetIds": [
                    "subnet-a",
                    "subnet-b"
                  ],
                  "securityGroupIds": [],
                  "clusterSecurityGroupId": "sg-cluster",
                  "vpcId": "vpc-1",
                  "endpointPublicAccess": false,
                  "endpointPrivateAccess": true,
                  "publicAccessCidrs": [
                    "0.0.0.0/0"
                  ]
                },
                "logging": {
                  "clusterLogging": [
                    {
                      "types": [
                        "api",
                        "audit",
                        "authenticator",
                        "controllerManager",
                        "scheduler"
                      ],
                      "enabled": true
                    }
                  ]
                },
                "status": "ACTIVE",
                "nodegroups": [],
                "fargateProfile": [],
                "updateRecodes": [],
                "clusterRole_EvaluationResults": {
                  "EvalActionName": "eks:*",
                  "EvalResourceName": "*",
                  "EvalDecision": "implicitDeny"
                }
              }
            ]
          },
          "ec2": {
            "describe_security_groups": [],
            "describe_vpcs": []
          }
        },
        "globals": {
          "iam": {
            "list_roles": [
              {
                "RoleName": "eks-cluster-role",
                "Arn": "arn:aws:iam::111122223333:role/eks-cluster-role",
                "AssumeRolePolicyDocument": {
                  "Version": "2012-10-17",
                  "Statement": [
                    {
                      "Effect": "Allow",
                      "Principal": {
                        "Service": "eks.amazonaws.com"
                      },
                      "Action": "sts:AssumeRole"
                    }
                  ]
                }
              }
            ]
          }
        }
      },
      "expect": {
        "verdict": "Vuln",
        "flag": 1
      }
    }
  ]
}
